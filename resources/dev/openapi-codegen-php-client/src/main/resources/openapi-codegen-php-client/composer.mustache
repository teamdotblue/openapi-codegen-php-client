{
    "name": "{{packageName}}",
    "description": "{{description}}",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Arne De Smedt",
            "email": "arne.desmedt@team.blue"
        }
    ],
    "require": {
        "php": "^8.1 || ^8.2",{{#additionalPackages}}
        "{{name}}": "{{version}}",{{/additionalPackages}}
        "team-blue/java-openapi-codegen-php-client": "^2.2",
        "team-blue/php-json-immutable-objects": "^1.0"
    },
    "require-dev": {
        "team-blue/php-client-mock": "^1.0",
        "combell/platforms-php-coding-standard": "^3.0",
        "phpmd/phpmd": "~2.0",
        "phpro/grumphp": "~2.0",
        "phpstan/phpstan": "~2.0",
        "rector/rector": "~2.0",
        "squizlabs/php_codesniffer": "~3.0"
    },
    "repositories": {
         "packeton.teamblue-ops.net": {
            "type": "composer",
            "url": "https://packeton.teamblue-ops.net"
        }
    },
    "autoload": {
        "psr-4": {
            "{{composerPackage}}\\": ""
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpro/grumphp": true
        },
        "sort-packages": true
    },
    "scripts-descriptions": {
        "tests": "Run all tests"
    },
    "scripts": {
        "tests": [
            "vendor/bin/phpcbf",
            "vendor/bin/phpcs -d memory_limit=256M",
            "vendor/bin/phpstan analyze --no-progress --memory-limit 256M",
            "vendor/bin/phpmd . text phpmd.xml --exclude vendor,resources,.openapi-generator",
            "vendor/bin/rector --dry-run --no-progress-bar"
        ]
    }
}
